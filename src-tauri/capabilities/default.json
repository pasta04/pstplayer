{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Capabilities for all PSTPlayer windows (main + settings + threads + yp)",
	"windows": ["main", "settings", "threads", "yp"],
	"permissions": [
		"core:default",
		"core:window:default",
		"core:webview:default",
		"core:webview:allow-create-webview-window",
		"core:event:default",
		"opener:default",
		"notification:default"
	]
}
